rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function caseData(uid, caseId) {
      return firestore.get(/databases/(default)/documents/cases/$(caseId)).data;
    }

    function ownsCase(uid, caseId) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && caseData(uid, caseId).ownerUid == uid;
    }

    match /users/{uid}/cases/{caseId}/{documentType} {
      allow create: if ownsCase(uid, caseId)
        && caseData(uid, caseId).status == 'uploading'
        && caseData(uid, caseId).documentTypes.hasAny([documentType])
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png']
        && request.resource.metadata.documentType == documentType
        && resource == null;

      allow read, update, delete: if false;
    }
  }
}
